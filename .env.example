# Pilih provider: "ollama" (gratis/lokal), "openai", "anthropic", atau "groq"
LLM_PROVIDER=ollama

# Kalau pakai Ollama (default, gratis)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Kalau pakai Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-instruct

# Kalau pakai OpenAI (berbayar)
OPENAI_API_KEY=

# Kalau pakai Anthropic (berbayar)
ANTHROPIC_API_KEY=

# Jumlah sample data per divisi untuk build vectorstore (kosongkan/None untuk pakai semua data)
SAMPLE_SIZE=8000